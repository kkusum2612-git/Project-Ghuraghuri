PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase is used only for shared image/file storage.
# Never commit real secret values here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=ghuraghuri-images

# ------------------------------------------------------------
# SSLCOMMERZ SANDBOX PAYMENT GATEWAY
# ------------------------------------------------------------
#
# Kusum Feature 3 uses the SSLCOMMERZ sandbox only.
#
# Put the REAL sandbox values in backend/.env.
# Never put real credentials in this example file or Git.
#
# These two values are provided when a sandbox store is created.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Public backend URL used by SSLCOMMERZ for payment callbacks.
#
# During normal local frontend/backend development this can remain:
# http://localhost:5000
#
# Important:
# SSLCOMMERZ's servers cannot send server-to-server IPN requests
# to localhost. Later, deployed testing can use a public backend URL.
BACKEND_PUBLIC_URL=http://localhost:5000

# ------------------------------------------------------------
# GROQ - RAFI FEATURE 4 AI TRAVEL PLANNER
# ------------------------------------------------------------
#
# GROQ_API_KEY is used only by the Express backend.
#
# Put the REAL key inside:
#
# backend/.env
#
# Never put the real key in:
#
# - this example file
# - frontend/.env
# - React code
# - GitHub
#
# React sends trip information to our Express API.
# Express then contacts Groq privately using this key.
GROQ_API_KEY=

# Keeping the model in an environment variable means we can
# change the Groq model later without rewriting the service code.
GROQ_MODEL=openai/gpt-oss-20b
# ------------------------------------------------------------
# RESEND - TAFSIR MODULE 3B NOTIFICATION ENGINE
# ------------------------------------------------------------
#
# Put the real Resend API key only inside backend/.env.
# Never commit the real API key to Git.
RESEND_API_KEY=

# Default sender for Resend.
# onboarding@resend.dev can be used during initial development.
RESEND_FROM_EMAIL=Ghuraghuri <onboarding@resend.dev>

# How many days before a trip collaborators receive a reminder.
UPCOMING_TRIP_ALERT_DAYS=3

# How often the backend checks for upcoming-trip notifications.
NOTIFICATION_TRIGGER_INTERVAL_MINUTES=60