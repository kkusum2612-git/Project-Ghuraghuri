{
  "name": "project-ghuraghuri",
  "version": "1.0.0",
  "private": true,
  "description": "Travel planning app with AI assistance",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkusum2612-git/Project-Ghuraghuri.git"
  },
  "bugs": {
    "url": "https://github.com/kkusum2612-git/Project-Ghuraghuri/issues"
  },
  "homepage": "https://github.com/kkusum2612-git/Project-Ghuraghuri#readme",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.9.5"
  }
}
